{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0xMinomus/bukalontar/main/packages/schema/analysis.json",
  "title": "BukaLontar AnalysisResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["manuscript_id", "source_reference", "paleography", "ethnomedicinal_entity", "scientific_validation"],
  "properties": {
    "manuscript_id": { "type": "string", "minLength": 1 },
    "reading_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "image_sha256", "title", "genre", "source_url", "transcript_license_url", "editorial_note"],
      "properties": {
        "method": { "const": "source_transcription" },
        "image_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "title": { "type": "string", "minLength": 1 },
        "genre": { "enum": ["Usadha", "Carcan", "Kakawin"] },
        "source_url": { "type": "string", "format": "uri" },
        "transcript_license_url": { "type": "string", "format": "uri" },
        "editorial_note": { "type": "string", "minLength": 1 }
      }
    },
    "reading_assistance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ocr_ms", "focus_regions", "leaf_regions", "example_count", "example_sources", "warnings"],
      "properties": {
        "mode": { "enum": ["none", "examples", "ocr", "both", "leaves", "all", "chart"] },
        "ocr_model": { "type": "string" },
        "ocr_ms": { "type": "integer", "minimum": 0 },
        "focus_regions": { "type": "integer", "minimum": 0, "maximum": 2 },
        "leaf_regions": { "type": "integer", "minimum": 0, "maximum": 2 },
        "example_count": { "type": "integer", "minimum": 0, "maximum": 3 },
        "example_sources": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lontar_group", "language"],
      "properties": {
        "lontar_group": {
          "enum": ["Usadha", "Usadha Taru Pramana", "Usadha Tiwang", "Usadha Dalem", "Usadha Yeh", "Tidak diketahui", "Non-Usadha"]
        },
        "lempir_number": { "type": "integer", "minimum": 1 },
        "language": { "enum": ["Kawi / Jawa Kuno", "Bali", "Bali Alus", "Tidak diketahui"] }
      }
    },
    "paleography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aksara_bali_detected", "confidence", "transliteration", "indonesian_translation", "english_translation"],
      "properties": {
        "aksara_bali_detected": { "type": "boolean" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "balinese_transcription": { "type": "string" },
        "transliteration": { "type": "string", "minLength": 1 },
        "indonesian_translation": { "type": "string", "minLength": 1 },
        "english_translation": { "type": "string", "minLength": 1 }
      }
    },
    "ethnomedicinal_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plant_local_name",
        "plant_scientific_name",
        "botanical_family",
        "kb_match",
        "plant_part_used",
        "energy_character",
        "formulation_type",
        "adjuvants",
        "target_ailment",
        "preparation_instructions"
      ],
      "properties": {
        "plant_local_name": { "type": "string", "minLength": 1 },
        "source_quote": { "type": "string", "minLength": 1 },
        "plant_scientific_name": { "type": "string" },
        "botanical_family": { "type": "string" },
        "kb_match": { "type": "boolean" },
        "plant_part_used": {
          "enum": ["Don (Daun)", "Babakan (Kulit Kayu)", "Akah (Akar)", "Buah", "Sekar (Bunga)", "Campuran", "Tidak disebutkan."]
        },
        "energy_character": { "enum": ["Panes (Hangat)", "Tis (Dingin)", "Dumelada (Sedang)", "Tidak disebutkan."] },
        "formulation_type": { "enum": ["Loloh (Minum)", "Boreh (Balur)", "Tutuh (Tetes)", "Sasap (Kompres)", "Tidak disebutkan."] },
        "adjuvants": { "type": "array", "items": { "type": "string" } },
        "target_ailment": { "type": "string", "minLength": 1 },
        "preparation_instructions": { "type": "string", "minLength": 1 }
      }
    },
    "scientific_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phytochemical_compounds", "modern_pharmacological_action", "reference_studies", "safety_disclaimer"],
      "properties": {
        "phytochemical_compounds": { "type": "array", "items": { "type": "string" } },
        "modern_pharmacological_action": { "type": "string" },
        "reference_studies": { "type": "array", "items": { "type": "string" } },
        "reference_links": { "$ref": "#/$defs/referenceLinks" },
        "safety_disclaimer": { "type": "string", "minLength": 1 }
      }
    },
    "recipes": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plant_local_name",
          "plant_scientific_name",
          "botanical_family",
          "kb_match",
          "plant_part_used",
          "energy_character",
          "formulation_type",
          "adjuvants",
          "target_ailment",
          "preparation_instructions",
          "phytochemical_compounds",
          "modern_pharmacological_action",
          "reference_studies"
        ],
        "properties": {
          "plant_local_name": { "type": "string", "minLength": 1 },
          "source_quote": { "type": "string", "minLength": 1 },
          "plant_scientific_name": { "type": "string" },
          "botanical_family": { "type": "string" },
          "kb_match": { "type": "boolean" },
          "plant_part_used": {
            "enum": ["Don (Daun)", "Babakan (Kulit Kayu)", "Akah (Akar)", "Buah", "Sekar (Bunga)", "Campuran", "Tidak disebutkan."]
          },
          "energy_character": { "enum": ["Panes (Hangat)", "Tis (Dingin)", "Dumelada (Sedang)", "Tidak disebutkan."] },
          "formulation_type": { "enum": ["Loloh (Minum)", "Boreh (Balur)", "Tutuh (Tetes)", "Sasap (Kompres)", "Tidak disebutkan."] },
          "adjuvants": { "type": "array", "items": { "type": "string" } },
          "target_ailment": { "type": "string", "minLength": 1 },
          "preparation_instructions": { "type": "string", "minLength": 1 },
          "phytochemical_compounds": { "type": "array", "items": { "type": "string" } },
          "modern_pharmacological_action": { "type": "string" },
          "reference_studies": { "type": "array", "items": { "type": "string" } },
          "reference_links": { "$ref": "#/$defs/referenceLinks" }
        }
      }
    }
  },
  "$defs": {
    "referenceLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "kind"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "kind": { "enum": ["literature", "literature_search"] }
        }
      }
    }
  }
}
