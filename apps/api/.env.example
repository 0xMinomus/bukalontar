# Server
PORT=8080
PUBLIC_ORIGIN=http://localhost:5173
# Optional: enable CORS if the browser calls the API directly, not via Vite proxy.
ALLOWED_ORIGIN=

# AI utama: 9router
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_MODEL=ag/gemini-3.8-flash-low
AI_API_KEY=
AI_TIMEOUT_SECONDS=120

# Fallback: model yang sama via Command Code
AI_FALLBACK_ENABLED=false
AI_FALLBACK_BASE_URL=https://api.commandcode.ai/provider/v1
AI_FALLBACK_MODEL=google/gemini-3.8-flash
AI_FALLBACK_API_KEY=

RATE_LIMIT_PER_MINUTE=10
